---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/case/ProjectDetail.astro';
import { getProjects, getProjectCopy, type ProjectEntry } from '../../lib/projects';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project, projects },
  }));
}

interface Props {
  project: ProjectEntry;
  projects: ProjectEntry[];
}

const locale = 'es' as const;
const { project, projects } = Astro.props;
const copy = getProjectCopy(project, locale);
const title = `${copy.title} — ${site.name}`;
---

<BaseLayout
  locale={locale}
  title={title}
  description={copy.summary}
  type="article"
>
  <ProjectDetail project={project} projects={projects} locale={locale} />
</BaseLayout>
