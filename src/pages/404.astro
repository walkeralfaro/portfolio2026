---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUi } from '../i18n/ui';
import { routeHref } from '../i18n/routes';
import { site } from '../lib/site';

const locale = 'es' as const;
const ui = getUi(locale);
const title = `${ui.pages.notFound.heading} — ${site.name}`;
---

<BaseLayout locale={locale} title={title} description={ui.pages.notFound.description}>
  <p class="not-found__code">{ui.pages.notFound.code}</p>
  <h1>{ui.pages.notFound.heading}</h1>
  <p>{ui.pages.notFound.message}</p>
  <p>
    <a href={routeHref(locale, { name: 'home' })}>{ui.actions.backHome}</a>
    <a href={routeHref(locale, { name: 'work' })}>{ui.actions.viewAllWork}</a>
  </p>
</BaseLayout>

<style>
  .not-found__code {
    margin: 0;
    color: var(--signal);
    font-size: var(--type-meta-size);
    font-weight: 700;
    letter-spacing: 0.08em;
  }
</style>
