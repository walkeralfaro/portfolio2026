---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUi } from '../../i18n/ui';
import { site } from '../../lib/site';

const locale = 'en' as const;
const ui = getUi(locale);
const title = `${ui.pages.cv.heading} — ${site.name}`;
---

<BaseLayout locale={locale} title={title} description={ui.pages.cv.description}>
  <h1>{ui.pages.cv.heading}</h1>
  <p>{ui.pages.cv.description}</p>
  <p>{ui.pages.cv.pending}</p>
  <p><a href={`mailto:${site.email}`}>{ui.profile.contact}</a></p>
</BaseLayout>
