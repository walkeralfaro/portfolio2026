---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonJsonLd from '../../components/shell/PersonJsonLd.astro';
import ProfileIntro from '../../components/profile/ProfileIntro.astro';
import FeaturedWork from '../../components/profile/FeaturedWork.astro';
import IndexExcerpt from '../../components/profile/IndexExcerpt.astro';
import CapabilityGrid from '../../components/profile/CapabilityGrid.astro';
import { getUi } from '../../i18n/ui';
import { routeHref } from '../../i18n/routes';
import { site } from '../../lib/site';
import { getProjects } from '../../lib/projects';

const locale = 'en' as const;
const ui = getUi(locale);
const projects = await getProjects();
const title = `${site.name} — ${ui.profile.role}`;
---

<BaseLayout locale={locale} title={title} description={ui.pages.home.description}>
  <PersonJsonLd slot="head" locale={locale} />
  <ProfileIntro locale={locale} />
  <FeaturedWork locale={locale} projects={projects} />
  <IndexExcerpt locale={locale} projects={projects} />
  <CapabilityGrid locale={locale} projects={projects} />
</BaseLayout>