---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkIndex from '../../../components/catalog/WorkIndex.astro';
import { getUi } from '../../../i18n/ui';
import { getProjects } from '../../../lib/projects';
import { site } from '../../../lib/site';

const locale = 'en' as const;
const ui = getUi(locale);
const projects = await getProjects();
const title = `${ui.pages.work.heading} — ${site.name}`;
---

<BaseLayout locale={locale} title={title} description={ui.pages.work.description}>
  <WorkIndex locale={locale} projects={projects} />
</BaseLayout>
