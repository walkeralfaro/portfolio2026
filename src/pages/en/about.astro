---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUi } from '../../i18n/ui';
import { routeHref } from '../../i18n/routes';
import { site } from '../../lib/site';
import { profileCopy } from '../../data/profile-copy';
import SkillTiers from '../../components/profile/SkillTiers.astro';
import ContactLinks from '../../components/profile/ContactLinks.astro';

const locale = 'en' as const;
const ui = getUi(locale);
const copy = profileCopy[locale].about;
const title = `${ui.pages.about.heading} — ${site.name}`;
---

<BaseLayout locale={locale} title={title} description={ui.pages.about.description}>
  <article class="about-page">
    <header class="about-page__intro">
      <h1>{ui.pages.about.heading}</h1>
      <p>{copy.intro}</p>
      <a href={routeHref(locale, { name: 'work' })}>{ui.actions.viewAllWork}</a>
    </header>

    <section class="about-page__background" aria-labelledby="about-background-title">
      <h2 id="about-background-title">{copy.backgroundTitle}</h2>
      <p>{copy.background}</p>
    </section>

    <SkillTiers locale={locale} />
  </article>
</BaseLayout>

<style>
  .about-page {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-12) var(--grid-gutter);
  }

  .about-page__intro {
    grid-column: 1 / -1;
    max-inline-size: 56rem;
    padding-block: var(--space-4) var(--space-8);
    border-block-end: 1px solid var(--line);
  }

  .about-page h1 {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: var(--type-display-size);
    letter-spacing: var(--type-display-tracking);
    line-height: var(--type-display-leading);
    text-wrap: balance;
  }

  .about-page__intro > p,
  .about-page__background > p {
    max-inline-size: var(--measure-prose);
    margin: var(--space-6) 0 var(--space-4);
    font-family: var(--font-family-serif);
    font-size: var(--type-body-size);
    line-height: var(--type-body-leading);
    text-wrap: pretty;
  }

  .about-page a {
    color: var(--signal);
    font-weight: 650;
    text-underline-offset: 0.2em;
  }

  .about-page a:hover {
    text-decoration-thickness: 2px;
  }

  .about-page h2 {
    margin: 0;
    font-size: var(--type-h2-size);
    line-height: var(--type-h2-leading);
    text-wrap: balance;
  }

  .about-page__background {
    grid-column: 2 / span 8;
    padding-inline-start: var(--space-6);
    border-inline-start: 2px solid var(--signal);
  }

  .about-page__background > p {
    margin-block-end: 0;
  }

  @media (max-width: 639.98px) {
    .about-page__background {
      grid-column: 1 / -1;
    }
  }
</style>
