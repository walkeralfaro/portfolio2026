---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  priority?: boolean;
  widths?: number[];
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  priority = false,
  widths = [480, 720, 960, 1320],
  sizes = '(min-width: 900px) 42vw, 100vw',
  class: className,
} = Astro.props;

const candidates = [...new Set([...widths.filter((width) => width < src.width), src.width])].sort(
  (first, second) => first - second,
);
---

<figure class:list={['project-cover', className]}>
  <Image
    src={src}
    alt={alt}
    widths={candidates}
    sizes={sizes}
    priority={priority}
    class="project-cover__image"
  />
</figure>

<style>
  .project-cover {
    aspect-ratio: var(--cover-aspect);
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .project-cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
