---
import { PROJECT_CATEGORIES, type ProjectCategory } from '../../content/project-slugs';
import { routeHref } from '../../i18n/routes';
import { getUi } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';

export type CatalogCounts = Record<'all' | ProjectCategory, number>;

interface Props {
  locale: Locale;
  counts: CatalogCounts;
  class?: string;
}

const { locale, counts, class: className } = Astro.props;
const ui = getUi(locale);
const filters = [
  {
    value: 'all' as const,
    label: ui.filters.all,
    count: counts.all,
    href: routeHref(locale, { name: 'work' }),
  },
  ...PROJECT_CATEGORIES.map((category) => ({
    value: category,
    label: ui.categories[category],
    count: counts[category],
    href: routeHref(locale, { name: 'work', category }),
  })),
];
---

<nav
  class:list={['category-filter', className]}
  aria-label={ui.filters.label}
  data-category-filter
>
  <ul class="category-filter__list">
    {
      filters.map((filter) => (
        <li class="category-filter__item">
          <a
            class="category-filter__link"
            href={filter.href}
            aria-current="page"
            data-filter={filter.value}
            data-filter-count={filter.count}
          >
            <span>{filter.label}</span>
            <span class="category-filter__count" aria-hidden="true">
              {filter.count}
            </span>
            <span class="visually-hidden">{ui.filters.countMany}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .category-filter {
    min-inline-size: 0;
  }

  .category-filter__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-filter__item {
    min-inline-size: 0;
  }

  .category-filter__link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    min-block-size: var(--control-min-size);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-family-sans);
    font-size: var(--type-meta-size);
    font-weight: 600;
    line-height: var(--type-meta-leading);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }

  .category-filter__link:hover {
    border-color: var(--ink);
    background: var(--surface);
  }

  .category-filter__link[aria-current='page'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .category-filter__count {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .category-filter__link[aria-current='page'] .category-filter__count {
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .category-filter__link {
      transition: none;
    }
  }
</style>
