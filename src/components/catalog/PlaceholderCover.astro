---
import type { ProjectCategory } from '../../content/project-slugs';
import { getPlaceholderMark } from '../../lib/placeholder-mark';
import MetaLabel from '../primitives/MetaLabel.astro';

interface Props {
  slug: string;
  name: string;
  category: ProjectCategory;
  categoryLabel: string;
  label: string;
  class?: string;
}

const { slug, name, category, categoryLabel, label, class: className } = Astro.props;
const mark = getPlaceholderMark(slug);
---

<div
  class:list={['placeholder-cover', className]}
  role="img"
  aria-label={label}
  data-category={category}
  data-mark={mark.seed}
>
  <div class="placeholder-cover__content">
    <MetaLabel>{categoryLabel}</MetaLabel>
    <span class="placeholder-cover__name">{name}</span>
  </div>

  <svg
    class="placeholder-cover__mark"
    viewBox="0 0 120 120"
    aria-hidden="true"
    focusable="false"
  >
    <g transform="translate(60 60)">
      <circle r="26" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
      <circle r="3.5" fill="currentColor"></circle>
      <rect
        x="-9"
        y="-9"
        width="18"
        height="18"
        transform={`rotate(${mark.rotation})`}
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
      ></rect>
      {
        mark.ticks.map((length, index) => (
          <line
            x1="0"
            y1="-32"
            x2="0"
            y2={-(32 + length)}
            transform={`rotate(${index * 30})`}
            stroke="currentColor"
            stroke-width="1.25"
          />
        ))
      }
    </g>
  </svg>
</div>

<style>
  .placeholder-cover {
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: var(--cover-aspect);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }

  .placeholder-cover__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(var(--space-3), 3.5cqi, var(--space-6));
  }

  .placeholder-cover__content :global(.meta-label) {
    max-inline-size: 55%;
    color: var(--muted);
  }

  .placeholder-cover__name {
    max-inline-size: 64%;
    font-family: var(--font-family-sans);
    font-size: clamp(1rem, 5.5cqi, 1.625rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .placeholder-cover__mark {
    position: absolute;
    inset-block-start: clamp(var(--space-3), 3.5cqi, var(--space-6));
    inset-inline-end: clamp(var(--space-3), 3.5cqi, var(--space-6));
    inline-size: min(34%, 9rem);
    block-size: auto;
    color: var(--signal);
  }
</style>
