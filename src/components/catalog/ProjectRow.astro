---
import type { ProjectEntry } from '../../lib/projects';
import { getProjectCopy } from '../../lib/projects';
import { routeHref } from '../../i18n/routes';
import { getUi } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';
import PlaceholderCover from './PlaceholderCover.astro';
import MetaLabel from '../primitives/MetaLabel.astro';
import StackList from '../primitives/StackList.astro';
import StatusBadge from '../primitives/StatusBadge.astro';

interface Props {
  project: ProjectEntry;
  locale: Locale;
  position: number;
  headingLevel?: 'h2' | 'h3';
}

const { project, locale, position, headingLevel = 'h2' } = Astro.props;
const ui = getUi(locale);
const copy = getProjectCopy(project, locale);
const data = project.data;
const categoryLabel = ui.categories[data.category];
const yearLabel = data.year === 'pending' ? ui.project.pending : String(data.year);
const detailHref = data.tier <= 2
  ? routeHref(locale, { name: 'project', slug: data.slug })
  : null;
const externalHref = data.tier === 3 ? (data.links.live ?? data.links.code) : null;
const href = detailHref ?? externalHref;
const isExternal = href !== null && detailHref === null;
const hasDestination = href !== null;
const RowTag = hasDestination ? 'a' : 'div';
const TitleTag = headingLevel;
const coverLabel = ui.catalog.coverAlt
  .replace('{title}', copy.title)
  .replace('{category}', categoryLabel);
---

<li
  class="project-row"
  data-project-row
  data-project={data.slug}
  data-category={data.category}
  data-tier={data.tier}
  data-index={position}
>
  <RowTag
    class:list={['project-row__inner', hasDestination && 'project-row__inner--link']}
    {...(href ? { href } : {})}
    data-row-destination={hasDestination ? (isExternal ? 'external' : 'internal') : 'pending'}
  >
    <span class="project-row__thumb" aria-hidden="true">
      <PlaceholderCover
        slug={data.slug}
        name={copy.title}
        category={data.category}
        categoryLabel={categoryLabel}
        label={coverLabel}
      />
    </span>

    <span class="project-row__content">
      <span class="project-row__meta">
        <MetaLabel>{yearLabel}</MetaLabel>
        <span class="project-row__category">{categoryLabel}</span>
      </span>

      <TitleTag class="project-row__title" translate="no">{copy.title}</TitleTag>
      <span class="project-row__summary">{copy.summary}</span>

      <StackList
        class="project-row__stack"
        label={ui.project.technologies}
        items={data.stack}
      />

      <span class="project-row__footer">
        <StatusBadge status={data.status} label={ui.statuses[data.status]} />
        {
          !hasDestination && (
            <span class="project-row__pending">
              <MetaLabel>{ui.project.pending}</MetaLabel>
              <span>{copy.availability ?? ui.actions.linksPending}</span>
            </span>
          )
        }
      </span>
    </span>
  </RowTag>
</li>

<style>
  .project-row {
    border-block-end: 1px solid var(--line);
  }

  .project-row:first-child {
    border-block-start: 1px solid var(--line);
  }

  .project-row__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: var(--space-6);
    color: inherit;
    text-decoration: none;
  }

  .project-row__inner--link:hover {
    background: color-mix(in srgb, var(--surface) 72%, transparent);
  }

  .project-row__inner:focus-visible {
    outline-offset: -3px;
  }

  .project-row__thumb {
    display: none;
  }

  .project-row__content {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
  }

  .project-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .project-row__category {
    color: var(--muted);
    font-family: var(--font-family-sans);
    font-size: var(--type-meta-size);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: var(--type-meta-leading);
    text-transform: uppercase;
  }

  .project-row__title {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: var(--type-row-size);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: var(--type-row-leading);
    text-wrap: balance;
  }

  .project-row__inner--link:hover .project-row__title {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .project-row__summary {
    display: -webkit-box;
    max-inline-size: var(--measure-prose);
    overflow: hidden;
    color: var(--muted);
    font-family: var(--font-family-sans);
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .project-row__stack {
    margin-block-start: var(--space-1);
  }

  .project-row__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-block-start: var(--space-1);
  }

  .project-row__pending {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1);
    color: var(--muted);
    font-family: var(--font-family-sans);
    font-size: var(--type-meta-size);
    line-height: var(--type-meta-leading);
  }

  @media (max-width: 899.98px) {
    .project-row__inner {
      grid-template-columns: minmax(5.25rem, 6.5rem) minmax(0, 1fr);
      gap: var(--space-4);
      align-items: start;
      padding-block: var(--space-4);
    }

    .project-row__thumb {
      display: block;
      min-inline-size: 0;
    }

    .project-row__thumb :global(.placeholder-cover__content) {
      display: none;
    }

    .project-row__thumb :global(.placeholder-cover__mark) {
      inset: 50% auto auto 50%;
      inline-size: 42%;
      transform: translate(-50%, -50%);
    }

    .project-row__title {
      font-size: 1.125rem;
    }

    .project-row__summary {
      font-size: 0.9375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-row__inner {
      scroll-behavior: auto;
    }
  }
</style>
