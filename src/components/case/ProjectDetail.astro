---
import type { Locale } from '../../i18n/locales';
import { getUi } from '../../i18n/ui';
import {
  getAdjacentProjects,
  getProjectCopy,
  type ProjectEntry,
} from '../../lib/projects';
import { getProjectGallery } from '../../lib/project-images';
import Prose from '../primitives/Prose.astro';
import CaseHeader from './CaseHeader.astro';
import CaseSection from './CaseSection.astro';
import DecisionList from './DecisionList.astro';
import ProjectPager from './ProjectPager.astro';
import ScreenshotGallery from './ScreenshotGallery.astro';

interface Props {
  project: ProjectEntry;
  projects: ProjectEntry[];
  locale: Locale;
}

const { project, projects, locale } = Astro.props;
const ui = getUi(locale);
const data = project.data;
const copy = getProjectCopy(project, locale);
const narrative = copy.narrative;
const adjacent = getAdjacentProjects(projects, data.slug);
const galleryImages = getProjectGallery(project, locale);

function paragraphs(value: string): string[] {
  return value
    .trim()
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}
---

<article class="project-detail" data-project-detail={data.slug}>
  <CaseHeader project={project} locale={locale} />

  <div class="project-detail__body" data-case-body>
    {
      narrative ? (
        <Prose class="case-body">
          <CaseSection>{ui.project.problem}</CaseSection>
          {paragraphs(narrative.problem).map((paragraph) => <p>{paragraph}</p>)}

          <CaseSection>{ui.project.role}</CaseSection>
          {paragraphs(narrative.role).map((paragraph) => <p>{paragraph}</p>)}

          <CaseSection>{ui.project.decisions}</CaseSection>
          <DecisionList>
            {narrative.decisions.map((decision) => (
              <li>
                <strong>{decision.title}.</strong>
                {paragraphs(decision.body).map((paragraph) => <p>{paragraph}</p>)}
              </li>
            ))}
          </DecisionList>

          <CaseSection>{ui.project.result}</CaseSection>
          {paragraphs(narrative.result).map((paragraph) => <p>{paragraph}</p>)}
        </Prose>
      ) : (
        <Prose class="case-body">
          <CaseSection>{ui.project.what}</CaseSection>
          <p>{copy.summary}</p>

          <CaseSection>{ui.project.role}</CaseSection>
          <p>{copy.role}</p>

          <CaseSection>{ui.project.result}</CaseSection>
          <p>{copy.result}</p>
        </Prose>
      )
    }

    {
      galleryImages.length > 0 && (
        <ScreenshotGallery project={project} locale={locale} images={galleryImages} />
      )
    }
  </div>

  {adjacent && (
    <ProjectPager
      locale={locale}
      previous={adjacent.previous}
      next={adjacent.next}
    />
  )}
</article>

<style>
  .project-detail {
    max-inline-size: 100%;
  }

  .project-detail__body {
    display: grid;
    gap: var(--space-8);
    max-inline-size: var(--measure-prose);
    margin-block: var(--space-12) 0;
  }

  .project-detail__body :global(.decision-list) {
    margin-block: var(--space-2) var(--space-8);
    padding: 0;
    list-style: none;
  }

  .project-detail__body :global(.decision-list li) {
    margin-block-start: 0;
  }

  .project-detail__body :global(.decision-list li p) {
    margin-block: var(--space-2) 0;
  }
</style>
