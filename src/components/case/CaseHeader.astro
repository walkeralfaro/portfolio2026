---
import type { Locale } from '../../i18n/locales';
import { routeHref } from '../../i18n/routes';
import { getUi } from '../../i18n/ui';
import { getProjectCopy, type ProjectEntry } from '../../lib/projects';
import Icon from '../icons/Icon.astro';
import MetaLabel from '../primitives/MetaLabel.astro';
import StackList from '../primitives/StackList.astro';
import StatusBadge from '../primitives/StatusBadge.astro';
import ProjectCover from '../catalog/ProjectCover.astro';
import ProjectActions from './ProjectActions.astro';

interface Props {
  project: ProjectEntry;
  locale: Locale;
  class?: string;
}

const { project, locale, class: className } = Astro.props;
const ui = getUi(locale);
const data = project.data;
const copy = getProjectCopy(project, locale);
const categoryLabel = ui.categories[data.category];
const yearLabel = data.year === 'pending' ? ui.project.pending : String(data.year);
---

<header class:list={['case-header', className]} data-case-header>
  <div class="case-header__main">
    <a class="case-header__back" href={routeHref(locale, { name: 'work' })}>
      <Icon name="arrow-left" />
      <span>{ui.actions.backToWork}</span>
    </a>

    <h1 class="case-header__title">{copy.title}</h1>
    <p class="case-header__summary">{copy.summary}</p>

    <dl class="case-header__meta">
      <div class="case-header__meta-item">
        <MetaLabel as="dt">{ui.project.year}</MetaLabel>
        <dd>{yearLabel}</dd>
      </div>
      <div class="case-header__meta-item">
        <MetaLabel as="dt">{ui.project.category}</MetaLabel>
        <dd>{categoryLabel}</dd>
      </div>
      <div class="case-header__meta-item">
        <MetaLabel as="dt">{ui.project.status}</MetaLabel>
        <dd><StatusBadge status={data.status} label={ui.statuses[data.status]} /></dd>
      </div>
    </dl>

    <div class="case-header__stack">
      <MetaLabel as="p">{ui.project.stack}</MetaLabel>
      <StackList label={ui.project.technologies} items={data.stack} />
    </div>

    <ProjectActions
      class="case-header__actions"
      locale={locale}
      live={data.links.live}
      code={data.links.code}
      availability={copy.availability}
    />
  </div>

  <div class="case-header__cover">
    <ProjectCover
      project={project}
      locale={locale}
      priority
      widths={[480, 720, 960]}
      sizes="(min-width: 900px) 33vw, 100vw"
    />
  </div>
</header>

<style>
  .case-header {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: var(--space-8);
    align-items: start;
    padding-block-end: var(--space-12);
    border-block-end: 1px solid var(--line);
  }

  .case-header__main {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    min-inline-size: 0;
    grid-column: 1 / span 7;
  }

  .case-header__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--muted);
    font-family: var(--font-family-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
  }

  .case-header__back:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .case-header__title {
    max-inline-size: 20ch;
    margin: var(--space-2) 0 0;
    font-family: var(--font-family-sans);
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .case-header__summary {
    max-inline-size: 48ch;
    margin: 0;
    font-family: var(--font-family-serif);
    font-size: clamp(1.125rem, 1.4vw, 1.3125rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .case-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin: var(--space-4) 0 0;
    padding-block: var(--space-4);
    border-block: 1px solid var(--line);
    width: 100%;
  }

  .case-header__meta-item {
    display: grid;
    gap: var(--space-1);
  }

  .case-header__meta dd {
    margin: 0;
    font-family: var(--font-family-sans);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
  }

  .case-header__stack {
    display: grid;
    gap: var(--space-2);
  }

  .case-header__actions {
    margin-block-start: var(--space-2);
  }

  .case-header__cover {
    grid-column: 9 / span 4;
    min-inline-size: 0;
  }

  @media (max-width: 899.98px) {
    .case-header {
      grid-template-columns: minmax(0, 1fr);
    }

    .case-header__main,
    .case-header__cover {
      grid-column: 1 / -1;
    }

    .case-header__title {
      max-inline-size: 18ch;
    }

    .case-header__cover {
      max-inline-size: 32rem;
    }
  }
</style>
