---
import Icon from '../icons/Icon.astro';

interface Props {
  id: string;
  label: string;
  closeLabel: string;
  caption?: string;
  class?: string;
}

const { id, label, closeLabel, caption, class: className } = Astro.props;
---

<dialog
  id={id}
  class:list={['lightbox', className]}
  aria-label={label}
  data-lightbox
>
  <div class="lightbox__frame">
    <div class="lightbox__toolbar">
      <button
        type="button"
        class="lightbox__close"
        aria-label={closeLabel}
        data-lightbox-close
      >
        <Icon name="close" />
      </button>
    </div>

    <div class="lightbox__body">
      <slot />
    </div>

    {caption && <p class="lightbox__caption">{caption}</p>}
  </div>
</dialog>

<style>
  .lightbox {
    --lightbox-block-limit: 90dvh;
    --lightbox-pad: clamp(var(--space-4), 3vw, var(--space-8));
    --lightbox-gap: var(--space-2);
    --lightbox-caption-space: 0px;

    width: min(94vw, 72rem);
    max-width: 94vw;
    max-height: 90vh;
    max-height: var(--lightbox-block-limit);
    margin: auto;
    padding: 0;
    overflow: hidden;
    overscroll-behavior: contain;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 30px 90px rgb(0 0 0 / 0.35);
  }

  .lightbox[open] {
    display: grid;
  }

  .lightbox:has(.lightbox__caption) {
    --lightbox-caption-space: 1.75rem;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.62);
  }

  .lightbox__frame {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--lightbox-gap);
    max-height: calc(var(--lightbox-block-limit) - 2px);
    min-block-size: 0;
    padding: var(--lightbox-pad);
  }

  .lightbox__toolbar {
    display: flex;
    justify-content: flex-end;
  }

  .lightbox__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--control-min-size);
    block-size: var(--control-min-size);
    padding: 0;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .lightbox__close:hover {
    border-color: var(--ink);
  }

  .lightbox__body {
    display: grid;
    place-items: center;
    min-inline-size: 0;
    min-block-size: 0;
    overflow: hidden;
  }

  .lightbox__body :global(img) {
    display: block;
    inline-size: auto;
    block-size: auto;
    max-inline-size: 100%;
    max-block-size: calc(
      var(--lightbox-block-limit) -
      (2 * var(--lightbox-pad)) -
      var(--control-min-size) -
      (2 * var(--lightbox-gap)) -
      var(--lightbox-caption-space) - 4px
    );
    object-fit: contain;
  }

  .lightbox__caption {
    max-inline-size: 65ch;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-family-sans);
    font-size: var(--type-meta-size);
    line-height: var(--type-meta-leading);
  }
</style>
