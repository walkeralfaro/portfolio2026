---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ol class:list={['decision-list', className]}>
  <slot />
</ol>

<style>
  .decision-list {
    display: grid;
    gap: 0;
    margin-block: var(--space-2) var(--space-8);
    padding: 0;
    list-style: none;
  }

  .decision-list :global(li) {
    position: relative;
    padding-block: var(--space-4);
    padding-inline-start: var(--space-6);
    border-inline-start: 1px solid var(--line);
  }

  .decision-list :global(li + li) {
    border-block-start: 1px solid var(--line);
    border-inline-start-color: var(--line);
  }

  .decision-list :global(li::before) {
    content: "";
    position: absolute;
    inset-block-start: 1.4em;
    inset-inline-start: -0.1875rem;
    inline-size: 0.3125rem;
    block-size: 0.3125rem;
    background: var(--signal);
  }
</style>
