---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../../i18n/locales';
import { getUi } from '../../i18n/ui';
import { getProjectCopy, type ProjectEntry } from '../../lib/projects';
import type { ResolvedGalleryImage } from '../../lib/project-images';
import Icon from '../icons/Icon.astro';
import Lightbox from './Lightbox.astro';

interface Props {
  project: ProjectEntry;
  locale: Locale;
  images?: ResolvedGalleryImage[];
  class?: string;
}

const { project, locale, images = [], class: className } = Astro.props;
const ui = getUi(locale);
const data = project.data;
const copy = getProjectCopy(project, locale);
const hasImages = images.length > 0;
const lightboxLabel = ui.caseStudy.lightboxLabel.replace('{title}', copy.title);

const candidatesFor = (image: ImageMetadata): number[] => {
  const widths = [288, 432, 576].filter((candidate) => candidate < image.width);

  return [...new Set([...widths, image.width])].sort((first, second) => first - second);
};

/*
 * The lightbox needs an emitted file for the full-size view. Using the original
 * `image.src` is unsafe: Astro deletes original assets that are only consumed by
 * `<Image>` and, when a gallery screenshot is byte-identical to the project
 * cover, the referenced path can differ from the one registered for processing,
 * leaving a 404. Asking the image service for the full-size variant guarantees
 * the file exists (and reuses the thumbnail's largest candidate).
 */
const lightboxSources = await Promise.all(
  images.map(async ({ image }) => {
    const variant = await getImage({ src: image, width: image.width, format: image.format });

    return variant.src;
  }),
);
---

{
  hasImages && (
    <div
      class:list={['screenshot-gallery', className]}
      data-gallery
      role="group"
      aria-label={ui.caseStudy.galleryLabel}
    >
      <ul class="screenshot-gallery__list">
        {images.map((entry, index) => (
          <li class="screenshot-gallery__item">
            <button
              type="button"
              class="screenshot-gallery__trigger"
              data-lightbox-open={`gallery-${data.slug}-${index}`}
              aria-haspopup="dialog"
            >
              <span class="visually-hidden">
                {ui.caseStudy.openImage
                  .replace('{title}', copy.title)
                  .replace('{alt}', entry.alt)}
              </span>
              <span
                class="screenshot-gallery__thumb"
                style={`--thumb-aspect: ${entry.image.width} / ${entry.image.height}`}
              >
                <Image
                  src={entry.image}
                  alt={entry.alt}
                  widths={candidatesFor(entry.image)}
                  sizes="(min-width: 900px) 20rem, 100vw"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="screenshot-gallery__hint" aria-hidden="true">
                <Icon name="expand" />
              </span>
            </button>
          </li>
        ))}
      </ul>

      {images.map((entry, index) => (
        <Lightbox
          id={`gallery-${data.slug}-${index}`}
          label={lightboxLabel}
          closeLabel={ui.caseStudy.closeLightbox}
        >
          <img
            src={lightboxSources[index]}
            alt={entry.alt}
            width={entry.image.width}
            height={entry.image.height}
            loading="lazy"
            decoding="async"
          />
        </Lightbox>
      ))}
    </div>
  )
}

<style>
  .screenshot-gallery {
    display: grid;
    gap: var(--space-3);
    margin-block: var(--space-4) var(--space-12);
  }

  .screenshot-gallery__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: start;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .screenshot-gallery__item {
    min-inline-size: 0;
  }

  .screenshot-gallery__trigger {
    display: grid;
    inline-size: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    cursor: zoom-in;
    text-align: start;
    transition: border-color 140ms ease;
  }

  .screenshot-gallery__trigger:hover {
    border-color: var(--ink);
  }

  .screenshot-gallery__thumb {
    display: block;
    aspect-ratio: var(--thumb-aspect, var(--cover-aspect));
    overflow: hidden;
  }

  .screenshot-gallery__thumb :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .screenshot-gallery__hint {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-block-start: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-family-sans);
    font-size: var(--type-meta-size);
    font-weight: 600;
    line-height: var(--type-meta-leading);
  }

  .screenshot-gallery__trigger:hover .screenshot-gallery__hint {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .screenshot-gallery__trigger {
      transition: none;
    }
  }
</style>

<script>
  import '../../scripts/lightbox';
</script>
