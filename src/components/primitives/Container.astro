---
interface Props {
  as?: 'div' | 'section' | 'main' | 'article' | 'header' | 'footer';
  id?: string;
  class?: string;
}

const { as: Tag = 'div', id, class: className } = Astro.props;
---

<Tag class:list={['site-container', className]} id={id}>
  <slot />
</Tag>

<style>
  .site-container {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    align-items: start;
    width: 100%;
    max-width: calc(var(--content-max) + 2 * var(--page-margin));
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
</style>
