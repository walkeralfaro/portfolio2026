---
import { otherLocale, type Locale } from '../../i18n/locales';
import { switchLocaleHref } from '../../i18n/routes';

interface Props {
  locale: Locale;
  pathname: string;
  search?: string;
  label: string;
  targetLabel: string;
}

const { locale, pathname, search = '', label, targetLabel } = Astro.props;
const targetLocale = otherLocale(locale);
const href = switchLocaleHref(targetLocale, pathname, search);
---

<a
  class="language-switcher"
  href={href}
  hreflang={targetLocale}
  lang={targetLocale}
  aria-label={`${targetLabel} — ${label}`}
  data-language-switcher
  data-locale={locale}
>
  {targetLabel}
</a>

<script>
  import { isLocale, otherLocale } from '../../i18n/locales';
  import { switchLocaleHref } from '../../i18n/routes';

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-language-switcher]')) {
    if (!isLocale(link.dataset.locale)) continue;

    link.href = switchLocaleHref(
      otherLocale(link.dataset.locale),
      window.location.pathname,
      window.location.search,
    );
  }
</script>

<style>
  .language-switcher {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-min-size);
    padding: var(--space-1) var(--space-2);
    color: var(--ink);
    font-family: var(--font-family-sans);
    font-size: var(--type-meta-size);
    font-weight: 600;
    line-height: var(--type-meta-leading);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.2em;
  }

  .language-switcher:hover {
    text-decoration-color: var(--signal);
  }
</style>
