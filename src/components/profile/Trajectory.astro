---
import type { Locale } from '../../i18n/locales';
import { profileCopy } from '../../data/profile-copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = profileCopy[locale].trajectory;
---

<section class="trajectory" aria-labelledby="trajectory-title" data-trajectory>
  <header class="trajectory__header">
    <h2 id="trajectory-title">{copy.title}</h2>
  </header>
  <ol>
    {copy.eras.map((era) => (
      <li>
        <p class="trajectory__dates">{era.dates}</p>
        <h3>{era.title}</h3>
        <p class="trajectory__description">{era.description}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .trajectory {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-8) var(--grid-gutter);
    padding-block: var(--space-12);
    border-block-end: 1px solid var(--line);
  }

  .trajectory__header {
    grid-column: span 4;
  }

  .trajectory__header h2 {
    margin: 0;
    font-size: var(--type-h2-size);
    line-height: var(--type-h2-leading);
  }

  .trajectory ol {
    display: grid;
    grid-column: span 8;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6) var(--grid-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trajectory li {
    min-inline-size: 0;
    padding-block-start: var(--space-3);
    border-block-start: 2px solid var(--signal);
  }

  .trajectory__dates {
    margin: 0;
    color: var(--signal);
    font-family: var(--font-family-sans);
    font-size: var(--type-meta-size);
    font-variant-numeric: tabular-nums;
    font-weight: 650;
  }

  .trajectory h3 {
    margin: var(--space-3) 0 0;
    font-family: var(--font-family-sans);
    font-size: 1.125rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  .trajectory__description {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (max-width: 899.98px) {
    .trajectory__header,
    .trajectory ol {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 639.98px) {
    .trajectory ol {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
</style>
