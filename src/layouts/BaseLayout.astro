---
import Container from '../components/primitives/Container.astro';
import SeoHead from '../components/shell/SeoHead.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import SiteHeader from '../components/shell/SiteHeader.astro';
import SkipLink from '../components/shell/SkipLink.astro';
import ThemeScript from '../components/shell/ThemeScript.astro';
import { getUi } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
}

const { locale, title, description, image, imageAlt, type } = Astro.props;
const ui = getUi(locale);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <SeoHead
      locale={locale}
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
    />
    <slot name="head" />
  </head>
  <body>
    <SkipLink label={ui.a11y.skipToContent} />
    <SiteHeader locale={locale} />
    <main id="main" class="site-main" tabindex="-1">
      <Container>
        <div class="site-main__inner">
          <slot />
        </div>
      </Container>
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>

<style>
  .site-main:focus-visible {
    outline: none;
  }

  .site-main__inner {
    grid-column: 1 / -1;
    min-inline-size: 0;
    padding-block: var(--space-8) var(--space-8);
  }
</style>
